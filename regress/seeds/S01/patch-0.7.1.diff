-extends UnitTestCase
-## The agree toggle of the terms popup (`CommonTermsCheck`) takes its lantern flame mark from `ResourceCore` with its own
-## owner scope, and the project theme does not reference `icon/flame`, so a scene that drops `icon/flame` leaves no
-## reference to it for the leak check.
-
-
-func before_each() -> void:
-	super()
-	assert_true(LogCore.init(), "LogCore.init")
-	assert_true(EventCore.init(), "EventCore.init")
-	assert_true(ResourceCore.init(), "ResourceCore.init")
-
-
-func after_each() -> void:
-	await super()
-	BootstrapCoreDev.shutdown()
-
-
-func test_the_theme_does_not_reference_the_flame() -> void:
-	var flame: String = "res://resource/icon/flame.png"
-	for dependency: String in ResourceLoader.get_dependencies("res://common/theme.tres"):
-		assert_false(dependency.ends_with(flame), "the theme references " + dependency)
-
-
-func test_the_toggle_loads_the_flame_with_its_owner_scope() -> void:
-	var toggle: CommonTermsCheck = CommonTermsCheck.new()
-	await toggle._load_mark()
-	assert_not_null(toggle._mark, "the flame mark is loaded")
-	assert_true(ResourceCore.is_loaded(ResourceKey.ICON__FLAME, ResourceCore.BaseKind.TEXTURE_2D), "icon/flame is cached")
-	toggle.free()
-	assert_false(ResourceCore.is_loaded(ResourceKey.ICON__FLAME, ResourceCore.BaseKind.TEXTURE_2D), "freeing the toggle drops icon/flame")

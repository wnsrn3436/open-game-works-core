+## The faint grid of cells, as one node per cell made again each frame, so that it follows the size of the control.
+func _process(_delta: float) -> void:
+	for child: Node in get_children():
+		remove_child(child)
+		child.free()
+	if _run == null or _room_tex == null:
+		return
+	var step: Vector2 = CryptConstants.MAP_CELL + Vector2(CryptConstants.MAP_GAP, CryptConstants.MAP_GAP)
+	var middle: Vector2 = size * 0.5 - CryptConstants.MAP_CELL * 0.5
+	var bounds: Rect2 = Rect2(Vector2.ZERO, size)
+	var reach: Vector2i = Vector2i(ceili(size.x * 0.5 / step.x), ceili(size.y * 0.5 / step.y))
+	for y: int in range(-reach.y, reach.y + 1):
+		for x: int in range(-reach.x, reach.x + 1):
+			var cell_rect: Rect2 = Rect2(middle + Vector2(float(x), float(y)) * step, CryptConstants.MAP_CELL)
+			if not bounds.encloses(cell_rect):
+				continue
+			var cell: TextureRect = TextureRect.new()
+			cell.texture = _room_tex
+			cell.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+			cell.mouse_filter = Control.MOUSE_FILTER_IGNORE
+			cell.position = cell_rect.position
+			cell.size = cell_rect.size
+			cell.self_modulate = CryptConstants.MAP_EMPTY
+			cell.show_behind_parent = true
+			add_child(cell)
+
+
 ## Whether the minimap draws `room`: it was visited or it is next to a visited room, and it is not a secret room that
 ## was not found yet.
 static func is_shown(rooms: Array[CryptRoom], room: CryptRoom) -> bool:
